parameters:
    level: max
    paths:
        - classes
        - tests
        - lib.php
        - settings.php
        - bdump.php
        - query_log.php
        - version.php
        - db/events.php
    excludePaths:
        - thirdparty/*
    # Needs a surrounding Moodle checkout — see README.md's "Static analysis".
    scanDirectories:
        - %currentWorkingDirectory%/lib
        - %currentWorkingDirectory%/privacy
    bootstrapFiles:
        - %currentWorkingDirectory%/admin/tool/tracy/thirdparty/tracy/src/tracy.php
    treatPhpDocTypesAsCertain: false
    ignoreErrors:
        # $plugin/$hassiteconfig/$ADMIN: Moodle convention, injected by whatever require()'s these.
        -
            message: '#Variable \$plugin might not be defined#'
            path: version.php
        -
            message: '#Variable \$(hassiteconfig|ADMIN) might not be defined#'
            path: settings.php
        # context_system: legacy alias Moodle creates at runtime, not statically visible.
        -
            message: '#unknown class context_system#'
